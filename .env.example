# Copy to .env before `docker compose up`. The real .env is git-ignored.
# These are demo defaults; change the password for anything beyond a local demo.

# PostgreSQL superuser created on first start of the postgres container.
POSTGRES_USER=collector
# Password for that user (also used by the collector to connect).
# It is embedded in the database URL: use only letters, digits and -._~, or URL-encode it.
POSTGRES_PASSWORD=change-me
# Database name created on first start.
POSTGRES_DB=plc_data_collector

# Host port on which the collector API is published (container port is always 8080).
COLLECTOR_API_PORT=8080

# Collector log level: DEBUG, INFO, WARNING or ERROR.
PLC_DATA_COLLECTOR_LOG_LEVEL=INFO
