{
  "connections": [
    {
      "id": "line1_opcua",
      "protocol": "opcua",
      "endpoint": "opc.tcp://opcua-sim:4840/plc-data-collector/sim/",
      "enabled": true,
      "timeout_ms": 5000,
      "protocol_options": {
        "auto_reconnect": false
      }
    },
    {
      "id": "press2_modbus",
      "protocol": "modbus",
      "endpoint": "tcp://modbus-sim:5020",
      "enabled": true,
      "timeout_ms": 2000,
      "protocol_options": {
        "unit_id": 1,
        "address_numbering": "modicon",
        "max_gap": 4
      }
    },
    {
      "id": "press3_s7",
      "protocol": "s7",
      "endpoint": "tcp://s7-sim:1102",
      "enabled": true,
      "timeout_ms": 2000,
      "protocol_options": {
        "rack": 0,
        "slot": 1
      }
    }
  ],
  "tag_groups": [
    {
      "id": "line1_fast",
      "connection_id": "line1_opcua",
      "interval_ms": 1000,
      "timeout_ms": 2000,
      "overlap_policy": "skip",
      "enabled": true
    },
    {
      "id": "press2_fast",
      "connection_id": "press2_modbus",
      "interval_ms": 1000,
      "timeout_ms": 2000,
      "overlap_policy": "skip",
      "enabled": true
    },
    {
      "id": "press3_fast",
      "connection_id": "press3_s7",
      "interval_ms": 1000,
      "timeout_ms": 2000,
      "overlap_policy": "skip",
      "enabled": true
    }
  ],
  "tags": [
